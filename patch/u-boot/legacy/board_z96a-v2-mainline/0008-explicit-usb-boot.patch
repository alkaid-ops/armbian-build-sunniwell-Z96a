--- a/include/configs/z96a_rk3568.h
+++ b/include/configs/z96a_rk3568.h
@@ -18,4 +18,20 @@
 
 #include <configs/rk3568_common.h>
 
+/* One-shot USB boot: power VBUS, then remove the marker before booting USB. */
+#undef CONFIG_BOOTCOMMAND
+#define CONFIG_BOOTCOMMAND \
+	"gpio set A6; gpio set E11; gpio set E9; gpio set C31; " \
+	"usb start; " \
+	"if fatload usb 0:1 ${loadaddr} /z96a-usb-once; then " \
+		"if fatrm usb 0:1 /z96a-usb-once; then " \
+			"setenv bootargs \"root=UUID=8638cb8f-5d1f-4ed6-a233-6f0faec1cb10 rw rootwait rootfstype=ext4 rootdelay=15 panic=10 clk_ignore_unused no_console_suspend consoleblank=0 fsck.fix=yes fsck.repair=yes net.ifnames=0\"; " \
+			"fatload usb 0:1 ${kernel_addr_r} /Image; " \
+			"fatload usb 0:1 ${fdt_addr_r} /dtb/rockchip/rk3568-sunniwell-z96a-typec.dtb; " \
+			"fatload usb 0:1 ${ramdisk_addr_r} /uInitrd; " \
+			"booti ${kernel_addr_r} ${ramdisk_addr_r}:${filesize} ${fdt_addr_r}; " \
+		"fi; " \
+	"fi; " \
+	"bootflow scan -lb"
+
 #endif
